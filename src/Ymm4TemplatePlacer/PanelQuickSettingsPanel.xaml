<UserControl x:Class="Ymm4TemplatePlacer.PanelQuickSettingsPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Ymm4TemplatePlacer">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleWhen"/>
 </UserControl.Resources>
 <TabControl x:Name="QuickSettingsTabs">
  <TabItem x:Name="PlacementQuickTab" Header="配置" Visibility="{Binding HasPlacementQuickDraft,Converter={StaticResource VisibleWhen}}">
   <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="8" DataContext="{Binding PlacementQuickDraft}">
     <TextBlock Text="配置のクイック設定" FontWeight="SemiBold" FontSize="14"/>
     <TextBlock Text="よく使う配置結果だけを変更します。細かい条件はそのまま保持します。" Opacity="0.72" TextWrapping="Wrap" Margin="0,2,0,7"/>

     <Border Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" Padding="7" Margin="0,0,0,8" CornerRadius="3">
      <StackPanel>
       <local:PlacementBehaviorPreview x:Name="QuickBehaviorPreview" DataContext="{Binding}" Margin="0,0,0,4"/>
       <TextBlock x:Name="QuickBehaviorSummary" Text="{Binding Summary}" TextWrapping="Wrap" FontSize="11" Opacity="0.8"/>
      </StackPanel>
     </Border>

     <TextBlock Text="合わせ位置" FontWeight="SemiBold"/>
     <WrapPanel Margin="0,3,0,8">
      <Button x:Name="QuickAlignStart" Content="開始から"
       Command="{Binding DataContext.ApplyPlacementQuickActionCommand,RelativeSource={RelativeSource AncestorType=local:PanelQuickSettingsPanel}}"
       CommandParameter="{x:Static local:PlacementQuickAction.AlignStart}" Padding="8,3"/>
      <Button x:Name="QuickAlignCenter" Content="中央に合わせる"
       Command="{Binding DataContext.ApplyPlacementQuickActionCommand,RelativeSource={RelativeSource AncestorType=local:PanelQuickSettingsPanel}}"
       CommandParameter="{x:Static local:PlacementQuickAction.AlignCenter}" Padding="8,3" Margin="4,0,0,0"/>
      <Button x:Name="QuickAlignEnd" Content="終了に合わせる"
       Command="{Binding DataContext.ApplyPlacementQuickActionCommand,RelativeSource={RelativeSource AncestorType=local:PanelQuickSettingsPanel}}"
       CommandParameter="{x:Static local:PlacementQuickAction.AlignEnd}" Padding="8,3" Margin="4,0,0,0"/>
     </WrapPanel>

     <TextBlock Text="長さ" FontWeight="SemiBold"/>
     <WrapPanel Margin="0,3,0,8">
      <Button x:Name="QuickDurationTargetSpan" Content="対象と同じ長さ"
       Command="{Binding DataContext.ApplyPlacementQuickActionCommand,RelativeSource={RelativeSource AncestorType=local:PanelQuickSettingsPanel}}"
       CommandParameter="{x:Static local:PlacementQuickAction.DurationTargetSpan}" Padding="8,3"/>
      <Button x:Name="QuickDurationTemplate" Content="テンプレートの長さ"
       Command="{Binding DataContext.ApplyPlacementQuickActionCommand,RelativeSource={RelativeSource AncestorType=local:PanelQuickSettingsPanel}}"
       CommandParameter="{x:Static local:PlacementQuickAction.DurationTemplate}" Padding="8,3" Margin="4,0,0,0"/>
     </WrapPanel>

     <TextBlock Text="レイヤー" FontWeight="SemiBold"/>
     <ListBox x:Name="QuickLayerModePicker" Margin="0,3,0,5"
      ItemsSource="{Binding DataContext.IntentLayerModes,RelativeSource={RelativeSource AncestorType=local:PanelQuickSettingsPanel}}"
      SelectedValuePath="Value" SelectedValue="{Binding LayerMode,Mode=TwoWay}" BorderThickness="0" Background="Transparent"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
      AutomationProperties.Name="簡易設定の配置レイヤー方式">
      <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Padding="10,4"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <WrapPanel Margin="0,0,0,8" Visibility="{Binding ShowRelativeLayerPlacement,Converter={StaticResource VisibleWhen}}">
      <Button x:Name="QuickLayerUpOne" Content="1段上"
       Command="{Binding DataContext.ApplyPlacementQuickActionCommand,RelativeSource={RelativeSource AncestorType=local:PanelQuickSettingsPanel}}"
       CommandParameter="{x:Static local:PlacementQuickAction.LayerUpOne}" Padding="8,3"/>
      <Button x:Name="QuickLayerDownOne" Content="1段下"
       Command="{Binding DataContext.ApplyPlacementQuickActionCommand,RelativeSource={RelativeSource AncestorType=local:PanelQuickSettingsPanel}}"
       CommandParameter="{x:Static local:PlacementQuickAction.LayerDownOne}" Padding="8,3" Margin="4,0,0,0"/>
     </WrapPanel>
     <StackPanel Margin="0,0,0,8" Visibility="{Binding ShowAbsoluteLayerPlacement,Converter={StaticResource VisibleWhen}}">
      <WrapPanel Margin="0,0,0,4">
       <TextBlock Text="レイヤー" VerticalAlignment="Center" Margin="0,0,5,0"/>
       <TextBox x:Name="QuickAbsoluteLayerBox" Text="{Binding AbsoluteLayer,UpdateSourceTrigger=PropertyChanged}" Width="64" ToolTip="空欄なら元レイヤー"/>
       <TextBlock Text="空欄=元" VerticalAlignment="Center" Margin="5,0,0,0" Opacity="0.72"/>
      </WrapPanel>
      <WrapPanel>
       <Button x:Name="QuickLayerSearchUp" Content="上へ探す"
        Command="{Binding DataContext.ApplyPlacementQuickActionCommand,RelativeSource={RelativeSource AncestorType=local:PanelQuickSettingsPanel}}"
        CommandParameter="{x:Static local:PlacementQuickAction.LayerSearchUp}" Padding="8,3"/>
       <Button x:Name="QuickLayerSearchDown" Content="下へ探す"
        Command="{Binding DataContext.ApplyPlacementQuickActionCommand,RelativeSource={RelativeSource AncestorType=local:PanelQuickSettingsPanel}}"
        CommandParameter="{x:Static local:PlacementQuickAction.LayerSearchDown}" Padding="8,3" Margin="4,0,0,0"/>
      </WrapPanel>
     </StackPanel>

     <TextBlock Text="{Binding DataContext.SettingsCommitNotice,RelativeSource={RelativeSource AncestorType=local:PanelQuickSettingsPanel}}" TextWrapping="Wrap" Margin="0,2,0,0"/>
     <TextBlock Text="{Binding DataContext.PlacementQuickSettingsNotice,RelativeSource={RelativeSource AncestorType=local:PanelQuickSettingsPanel}}" TextWrapping="Wrap" Opacity="0.72" Margin="0,2,0,6"/>
     <Button x:Name="QuickOpenFullSettings" Content="細かい設定を開く"
      Command="{Binding DataContext.OpenCurrentSetSettingsCommand,RelativeSource={RelativeSource AncestorType=local:PanelQuickSettingsPanel}}"
      HorizontalAlignment="Left" Padding="8,3"/>
    </StackPanel>
   </ScrollViewer>
  </TabItem>

  <TabItem x:Name="PresentationQuickTab" Header="表示・操作">
   <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="8">
     <TextBlock Text="パネル簡易設定" FontWeight="SemiBold" FontSize="14"/>
     <TextBlock Text="配置中によく触る見た目・操作だけを変更します。" Opacity="0.72" TextWrapping="Wrap" Margin="0,2,0,8"/>

     <TextBlock Text="現在のSetの形" FontWeight="SemiBold"/>
     <WrapPanel Margin="0,3,0,8">
      <Button x:Name="QuickShapeRounded" Content="角丸" Command="{Binding ShapeCurrentIntentSetCommand}" CommandParameter="{x:Static local:IntentTileShape.Rounded}" Padding="8,3"/>
      <Button x:Name="QuickShapeSquare" Content="四角" Command="{Binding ShapeCurrentIntentSetCommand}" CommandParameter="{x:Static local:IntentTileShape.Square}" Padding="8,3" Margin="4,0,0,0"/>
      <Button x:Name="QuickShapeCircle" Content="丸" Command="{Binding ShapeCurrentIntentSetCommand}" CommandParameter="{x:Static local:IntentTileShape.Circle}" Padding="8,3" Margin="4,0,0,0"/>
     </WrapPanel>

     <Separator/>

     <StackPanel DataContext="{Binding PanelQuickPresentation}" IsEnabled="{Binding DataContext.CanEditPanelQuickSettings,RelativeSource={RelativeSource AncestorType=local:PanelQuickSettingsPanel}}">
      <TextBlock Text="タイルの並び方" FontWeight="SemiBold" Margin="0,5,0,3"/>
      <WrapPanel>
       <ComboBox x:Name="QuickLayoutPicker" ItemsSource="{Binding LayoutModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding LayoutMode,Mode=TwoWay}" MinWidth="120" AutomationProperties.Name="簡易設定の列の並べ方"/>
       <TextBox x:Name="QuickFixedColumnsBox" Text="{Binding FixedColumns,UpdateSourceTrigger=PropertyChanged}" Width="44" IsEnabled="{Binding IsFixed}" Margin="5,0,0,0" AutomationProperties.Name="簡易設定の固定列数"/>
       <TextBlock Text="列" VerticalAlignment="Center" Margin="4,0"/>
      </WrapPanel>

      <CheckBox x:Name="QuickEnableShortcuts" Content="位置ショートカットを使う" IsChecked="{Binding ShortcutsEnabled,Mode=TwoWay}" Margin="0,7,0,3"/>

      <Expander Header="位置ショートカットの割り当て" Margin="0,2,0,0">
       <StackPanel Margin="8,4">
        <TextBlock Text="位置は左上から1、2、3…です。Setを切り替えても同じ位置のキーを使います。" TextWrapping="Wrap" Opacity="0.72" Margin="0,0,0,4"/>
        <ItemsControl x:Name="QuickShortcutRows" ItemsSource="{Binding Shortcuts}">
         <ItemsControl.ItemTemplate><DataTemplate>
          <WrapPanel Margin="0,1">
           <TextBlock Text="位置" VerticalAlignment="Center" Margin="0,0,4,0"/>
           <TextBox Text="{Binding Position,UpdateSourceTrigger=PropertyChanged}" Width="42" MaxLength="3" AutomationProperties.Name="簡易設定のショートカット位置"/>
           <TextBox Text="{Binding Gesture,UpdateSourceTrigger=PropertyChanged}" Width="116" MaxLength="32" Margin="4,0" ToolTip="例: A / Ctrl+1 / Shift+F1" AutomationProperties.Name="簡易設定の割り当てキー"/>
           <Button Content="外す" Command="{Binding DataContext.RemoveShortcutCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="5,2"/>
          </WrapPanel>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="QuickAddShortcut" Content="＋ キーを設定" Command="{Binding AddShortcutCommand}" HorizontalAlignment="Left" Padding="7,3" Margin="0,3,0,0"/>
       </StackPanel>
      </Expander>
     </StackPanel>

     <TextBlock x:Name="QuickSettingsNotice" Text="{Binding PanelQuickSettingsNotice}" TextWrapping="Wrap" Margin="0,7,0,0"/>
     <TextBlock Text="Setの条件・配置関係・テンプレート管理は「設定」タブで変更します。" TextWrapping="Wrap" Opacity="0.72" Margin="0,5,0,0"/>
    </StackPanel>
   </ScrollViewer>
  </TabItem>
 </TabControl>
</UserControl>
