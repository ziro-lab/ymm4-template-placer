<UserControl x:Class="Ymm4TemplatePlacer.PanelQuickSettingsPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Ymm4TemplatePlacer">
 <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="2">
   <TextBlock Text="パネル簡易設定" FontWeight="SemiBold" FontSize="14"/>
   <TextBlock Text="配置中によく触る見た目・操作だけを変更します。" Opacity="0.72" TextWrapping="Wrap" Margin="0,2,0,8"/>

   <TextBlock Text="現在のSetの形" FontWeight="SemiBold"/>
   <WrapPanel Margin="0,3,0,8">
    <Button x:Name="QuickShapeRounded" Content="角丸" Command="{Binding ShapeCurrentIntentSetCommand}" CommandParameter="{x:Static local:IntentTileShape.Rounded}" Padding="8,3"/>
    <Button x:Name="QuickShapeSquare" Content="四角" Command="{Binding ShapeCurrentIntentSetCommand}" CommandParameter="{x:Static local:IntentTileShape.Square}" Padding="8,3" Margin="4,0,0,0"/>
    <Button x:Name="QuickShapeCircle" Content="丸" Command="{Binding ShapeCurrentIntentSetCommand}" CommandParameter="{x:Static local:IntentTileShape.Circle}" Padding="8,3" Margin="4,0,0,0"/>
   </WrapPanel>

   <Separator/>

   <StackPanel DataContext="{Binding PanelQuickPresentation}" IsEnabled="{Binding DataContext.CanEditPanelQuickSettings,RelativeSource={RelativeSource AncestorType=local:PanelQuickSettingsPanel}}">
    <TextBlock Text="タイルの並び方" FontWeight="SemiBold" Margin="0,5,0,3"/>
    <WrapPanel>
     <ComboBox x:Name="QuickLayoutPicker" ItemsSource="{Binding LayoutModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding LayoutMode,Mode=TwoWay}" MinWidth="120" AutomationProperties.Name="簡易設定の列の並べ方"/>
     <TextBox x:Name="QuickFixedColumnsBox" Text="{Binding FixedColumns,UpdateSourceTrigger=PropertyChanged}" Width="44" IsEnabled="{Binding IsFixed}" Margin="5,0,0,0" AutomationProperties.Name="簡易設定の固定列数"/>
     <TextBlock Text="列" VerticalAlignment="Center" Margin="4,0"/>
    </WrapPanel>

    <CheckBox x:Name="QuickEnableShortcuts" Content="位置ショートカットを使う" IsChecked="{Binding ShortcutsEnabled,Mode=TwoWay}" Margin="0,7,0,3"/>

    <Expander Header="位置ショートカットの割り当て" Margin="0,2,0,0">
     <StackPanel Margin="8,4">
      <TextBlock Text="位置は左上から1、2、3…です。Setを切り替えても同じ位置のキーを使います。" TextWrapping="Wrap" Opacity="0.72" Margin="0,0,0,4"/>
      <ItemsControl x:Name="QuickShortcutRows" ItemsSource="{Binding Shortcuts}">
       <ItemsControl.ItemTemplate><DataTemplate>
        <WrapPanel Margin="0,1">
         <TextBlock Text="位置" VerticalAlignment="Center" Margin="0,0,4,0"/>
         <TextBox Text="{Binding Position,UpdateSourceTrigger=PropertyChanged}" Width="42" MaxLength="3" AutomationProperties.Name="簡易設定のショートカット位置"/>
         <TextBox Text="{Binding Gesture,UpdateSourceTrigger=PropertyChanged}" Width="116" MaxLength="32" Margin="4,0" ToolTip="例: A / Ctrl+1 / Shift+F1" AutomationProperties.Name="簡易設定の割り当てキー"/>
         <Button Content="外す" Command="{Binding DataContext.RemoveShortcutCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="5,2"/>
        </WrapPanel>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button x:Name="QuickAddShortcut" Content="＋ キーを設定" Command="{Binding AddShortcutCommand}" HorizontalAlignment="Left" Padding="7,3" Margin="0,3,0,0"/>
     </StackPanel>
    </Expander>
   </StackPanel>

   <TextBlock x:Name="QuickSettingsNotice" Text="{Binding PanelQuickSettingsNotice}" TextWrapping="Wrap" Margin="0,7,0,0"/>
   <TextBlock Text="Setの条件・配置関係・テンプレート管理は「設定」タブで変更します。" TextWrapping="Wrap" Opacity="0.72" Margin="0,5,0,0"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
