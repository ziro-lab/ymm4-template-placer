<UserControl x:Class="Ymm4TemplatePlacer.PalettePresentationPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Ymm4TemplatePlacer">
 <Expander Header="パレット共通の表示・キー設定" Margin="0,5" DataContext="{Binding IntentSettings.Presentation}">
  <StackPanel Margin="8,5">
   <WrapPanel>
    <ComboBox x:Name="LayoutPicker" ItemsSource="{Binding LayoutModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding LayoutMode,Mode=TwoWay}" MinWidth="120" AutomationProperties.Name="パレットの列の並べ方"/>
    <TextBox x:Name="FixedColumnsBox" Text="{Binding FixedColumns,UpdateSourceTrigger=PropertyChanged}" Width="48" IsEnabled="{Binding IsFixed}" AutomationProperties.Name="固定列数"/>
    <TextBlock Text="列（1～16）" VerticalAlignment="Center" Margin="5,0"/>
   </WrapPanel>
   <CheckBox x:Name="EnablePositionShortcuts" Content="位置ショートカットを使う（固定列の配置画面のみ）" IsChecked="{Binding ShortcutsEnabled,Mode=TwoWay}" Margin="0,5"/>
   <TextBlock Text="位置は左上から1、2、3…と数えます。並び替えると、その位置の新しいタイルが実行されます。" TextWrapping="Wrap"/>
   <ItemsControl x:Name="PositionShortcutRows" ItemsSource="{Binding Shortcuts}">
    <ItemsControl.ItemTemplate><DataTemplate>
     <WrapPanel>
      <TextBlock Text="位置" VerticalAlignment="Center" Margin="0,0,5,0"/>
      <TextBox Text="{Binding Position,UpdateSourceTrigger=PropertyChanged}" Width="48" MaxLength="3" AutomationProperties.Name="ショートカットの位置"/>
      <TextBox Text="{Binding Gesture,UpdateSourceTrigger=PropertyChanged}" Width="128" MaxLength="32" ToolTip="例: A / Ctrl+1 / Shift+F1" AutomationProperties.Name="位置に割り当てるキー"/>
      <Button Content="外す" Command="{Binding DataContext.RemoveShortcutCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
     </WrapPanel>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <Button x:Name="AddPositionShortcut" Content="＋ キーを設定" Command="{Binding AddShortcutCommand}" HorizontalAlignment="Left"/>
  </StackPanel>
 </Expander>
</UserControl>
