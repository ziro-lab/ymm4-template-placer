<UserControl x:Class="Ymm4TemplatePlacer.PalettePanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><Style x:Key="BrowseOnly" TargetType="FrameworkElement"><Style.Triggers><DataTrigger Binding="{Binding IsCreatingPalette}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></UserControl.Resources>
 <Grid Margin="6">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,6">
   <Button x:Name="NewPaletteButton" Content="＋ パレット" Command="{Binding BeginCreatePaletteCommand}" DockPanel.Dock="Right" Padding="8,3" Margin="6,0,0,0"/>
   <ComboBox x:Name="PaletteSelector" ItemsSource="{Binding PaletteChoices}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPalette,Mode=TwoWay}" TextSearch.TextPath="Name" AutomationProperties.Name="パレット"/>
  </DockPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,6">
   <TextBlock Text="{Binding PaletteContextStatus}" ToolTip="{Binding PaletteContextDetail}" TextWrapping="Wrap" Opacity="0.75">
    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding PaletteContextStatus}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
   <StackPanel x:Name="CreatePaletteForm" Margin="0,0,0,6">
    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCreatingPalette}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <TextBlock Text="パレット名"/><TextBox x:Name="NewPaletteNameBox" Text="{Binding NewPaletteName,UpdateSourceTrigger=PropertyChanged}" MaxLength="256" AutomationProperties.Name="新しいパレット名"/>
    <TextBlock Text="連動キャラクター" Margin="0,4,0,0"/>
    <ComboBox x:Name="NewCharacterCombo" ItemsSource="{Binding LibraryCharacters}" DisplayMemberPath="Label" SelectedItem="{Binding NewPaletteCharacter,Mode=TwoWay}" ToolTip="指定したキャラクターの音声・表情を単体選択すると自動で切り替わります。指定なしのパレットは手動で使います。"/>
    <WrapPanel Margin="0,5,0,0"><Button x:Name="CreatePaletteButton" Content="作成" Command="{Binding CreatePaletteCommand}" Padding="12,4" Margin="0,0,6,0"/><Button Content="キャンセル" Command="{Binding CancelCreatePaletteCommand}" Padding="10,4"/></WrapPanel>
   </StackPanel>
   <WrapPanel Style="{StaticResource BrowseOnly}">
    <Button x:Name="AddTemplateButton" Content="＋ テンプレートを追加" Command="{Binding OpenAddTemplateCommand}" Padding="10,5" Margin="0,0,6,0"/>
    <Button x:Name="ManageTemplatesButton" Content="テンプレート管理…" Command="{Binding OpenTemplateManagementCommand}" Padding="6,4" ToolTip="元の参照確認・名前変更・再リンク・登録解除"/>
   </WrapPanel>
  </StackPanel>
  <Grid Grid.Row="2" Style="{StaticResource BrowseOnly}">
   <ListBox x:Name="PaletteList" ItemsSource="{Binding PaletteEntries}" SelectedItem="{Binding SelectedPaletteEntry,Mode=TwoWay}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5,4">
     <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
     <TextBlock Text="{Binding SourceDetail}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceDetail}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SourceDetail}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.75"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <TextBlock Text="{Binding PaletteEmptyMessage}" TextWrapping="Wrap" Margin="8" IsHitTestVisible="False"/>
  </Grid>
  <ContentControl x:Name="DropControls" Style="{StaticResource BrowseOnly}" Grid.Row="3"/>
  <Expander x:Name="PaletteEditor" Style="{StaticResource BrowseOnly}" Grid.Row="4" Header="このパレットを編集" Margin="0,6,0,0">
   <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,4,0,0">
     <TextBlock Text="パレット名"/>
     <DockPanel><Button Content="変更" Command="{Binding RenamePaletteCommand}" DockPanel.Dock="Right" Padding="8,4" Margin="6,0,0,0"/><TextBox Text="{Binding PaletteNameDraft,UpdateSourceTrigger=PropertyChanged}" MaxLength="256"/></DockPanel>
     <WrapPanel Margin="0,4,0,0"><Button Content="選択テンプレートを外す" Command="{Binding RemovePaletteEntryCommand}" Padding="8,4" Margin="0,0,6,4"/><Button Content="パレットを削除" Command="{Binding DeletePaletteCommand}" Padding="8,4" Margin="0,0,0,4" ToolTip="元テンプレート・登録・タイムラインは削除しません。"/></WrapPanel>
    </StackPanel>
   </ScrollViewer>
  </Expander>
 </Grid>
</UserControl>
