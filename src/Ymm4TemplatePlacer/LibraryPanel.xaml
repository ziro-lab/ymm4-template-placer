<UserControl x:Class="Ymm4TemplatePlacer.LibraryPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="6">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0">
   <TextBlock Text="YMM4 Templateへの参照を、短い名前で整理します。" TextWrapping="Wrap"/>
   <TextBlock Text="単一ItemのTemplateをYMM4で登録し、一覧を更新してください。" TextWrapping="Wrap" Opacity="0.7"/>
   <TextBlock Text="{Binding LibraryNotice}" TextWrapping="Wrap" FontWeight="Bold"/>
  </StackPanel>
  <DockPanel Grid.Row="1" Margin="0,6">
   <Button Content="一覧更新" Command="{Binding RefreshLibraryCommand}" DockPanel.Dock="Right" Padding="10,4" Margin="6,0,0,0"/>
   <TextBox Text="{Binding LibrarySearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="表示名・元Template名で絞り込み" VerticalContentAlignment="Center"/>
  </DockPanel>
  <ListBox x:Name="EntryList" Grid.Row="2" ItemsSource="{Binding LibraryEntries}" SelectedItem="{Binding SelectedLibraryEntry,Mode=TwoWay}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
   <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,3">
    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="{Binding SourceName}" Opacity="0.7" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceName}"/>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
   </StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <StackPanel Grid.Row="3" Margin="0,6,0,0">
   <TextBlock Text="元のYMM4 Template（追加・再リンク先）"/>
   <ComboBox x:Name="SourceCombo" ItemsSource="{Binding SourceTemplates}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSourceTemplate,Mode=TwoWay}" IsTextSearchEnabled="True" ToolTip="同名候補を自動で選びません。曖昧な場合はYMM4側で区別してください。"/>
  </StackPanel>
  <WrapPanel Grid.Row="4" Margin="0,6">
   <StackPanel Margin="0,0,8,0"><TextBlock Text="Plugin表示名"/><TextBox x:Name="DisplayNameBox" Text="{Binding LibraryDisplayName,UpdateSourceTrigger=PropertyChanged}" Width="180" MaxLength="256"/></StackPanel>
   <StackPanel><TextBlock Text="Character（任意）"/><ComboBox ItemsSource="{Binding LibraryCharacters}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedLibraryCharacter,Mode=TwoWay}" MinWidth="120"/></StackPanel>
  </WrapPanel>
  <WrapPanel Grid.Row="5">
   <Button x:Name="RegisterButton" Content="新規登録" Command="{Binding RegisterLibraryCommand}" Padding="10,5" Margin="0,0,6,4"/>
   <Button Content="名前等を保存" Command="{Binding SaveLibraryCommand}" Padding="10,5" Margin="0,0,6,4"/>
   <Button x:Name="RelinkButton" Content="再リンク" Command="{Binding RelinkLibraryCommand}" Padding="10,5" Margin="0,0,6,4"/>
   <Button Content="登録解除" Command="{Binding UnregisterLibraryCommand}" Padding="10,5" Margin="0,0,0,4" ToolTip="Libraryから外すだけです。元TemplateとTimelineは削除しません。"/>
  </WrapPanel>
 </Grid>
</UserControl>
