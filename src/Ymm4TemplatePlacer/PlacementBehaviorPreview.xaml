<UserControl x:Class="Ymm4TemplatePlacer.PlacementBehaviorPreview"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Focusable="False" IsHitTestVisible="False" UseLayoutRounding="True">
 <StackPanel>
  <TextBlock x:Name="CaptionText" FontWeight="SemiBold" TextWrapping="Wrap"/>
  <TextBlock x:Name="ScopeText" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
  <Canvas x:Name="DiagramCanvas" Height="110" ClipToBounds="True"/>
  <TextBlock x:Name="LayerText" TextWrapping="Wrap" FontSize="12"/>
  <TextBlock x:Name="FallbackText" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"/>
  <TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="11" Opacity="0.75" Margin="0,2,0,0"/>
 </StackPanel>
</UserControl>
