<UserControl x:Class="Ymm4TemplatePlacer.IntentPalettePanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Ymm4TemplatePlacer">
 <Grid Margin="6">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <Grid x:Name="IntentContextHeader" Grid.Row="0" Margin="3,1,3,7" MinHeight="52">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IntentContextTitle}" Value=""><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <TextBlock x:Name="IntentContextTitleText" Text="{Binding IntentContextTitle}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="IntentContextDetailText" Text="{Binding IntentContextDetail}" Opacity="0.72" TextTrimming="CharacterEllipsis" ToolTip="{Binding IntentContextDetail}"/>
    <TextBlock x:Name="ContextCompatibilityNoticeText" Text="{Binding PlacementContextCompatibilityNotice}" TextWrapping="Wrap" Margin="0,4,0,0" FontWeight="SemiBold">
     <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding PlacementContextCompatibilityNotice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Button x:Name="NativeUndoButton" Content="↶ 戻す" Command="{Binding NativeUndoCommand}" Width="80" Height="48" Padding="6,0" FontSize="14" FontWeight="SemiBold"
     ToolTip="戻す（YMM4の元に戻す）" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="戻す"/>
    <Button x:Name="NativeRedoButton" Content="↷ やり直す" Command="{Binding NativeRedoCommand}" Width="88" Height="48" Padding="6,0" FontSize="14" FontWeight="SemiBold" Margin="4,0,0,0"
     ToolTip="やり直す（YMM4のやり直し）" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="やり直す"/>
   </StackPanel>
   <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
    <local:GenericLayerTargetPanel x:Name="GenericLayerSurface" Width="82"/>
   </Grid>
  </Grid>

  <TextBlock x:Name="SingleSetTitleText" Grid.Row="1" Text="{Binding SelectedIntentSet.Label}" ToolTip="{Binding SelectedIntentSet.Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="4,0,4,6">
   <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowSingleSetName}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding HasIntentSets}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
  </TextBlock>

  <Grid x:Name="IntentSetRow" Grid.Row="2" Margin="2,6,2,0" AllowDrop="True" DragOver="SetStripDragOver" Drop="SetStripDrop" DragLeave="SetStripDragLeave">
   <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding HasIntentSets}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <!-- The native selected TabItem overlaps this shared content edge. No per-Set content is created. -->
   <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="1" Background="{Binding BorderBrush,ElementName=IntentSetSegments}"/>
   <Button x:Name="IntentSetScrollLeftButton" Grid.Column="0" Content="‹" Width="26" Margin="0,2,2,1" Padding="0"
    IsEnabled="False" Click="IntentSetScrollLeft" ToolTip="左のセットを表示" AutomationProperties.Name="左のセットを表示"/>
   <TabControl x:Name="IntentSetSegments" Grid.Column="1" ItemsSource="{Binding IntentSets}" SelectedItem="{Binding SelectedIntentSet,Mode=TwoWay}"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" SelectionChanged="IntentSetSelectionChanged"
    AutomationProperties.Name="セットを切り替える" SnapsToDevicePixels="True">
    <TabControl.Template><ControlTemplate TargetType="TabControl">
     <!-- Retain the theme's TabItem template, colours, focus and selection border. Only the header host is bounded. -->
     <ScrollViewer x:Name="IntentSetHeaderScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False"
      Focusable="False" ScrollChanged="IntentSetHeaderScrollChanged" KeyboardNavigation.TabNavigation="Once">
      <ItemsPresenter x:Name="ItemsPresenter" Margin="2,2,2,1"/>
     </ScrollViewer>
    </ControlTemplate></TabControl.Template>
    <TabControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></TabControl.ItemsPanel>
    <TabControl.ItemContainerStyle><Style TargetType="TabItem">
     <Setter Property="AllowDrop" Value="True"/>
     <EventSetter Event="PreviewMouseLeftButtonDown" Handler="SetPointerDown"/>
     <EventSetter Event="PreviewMouseLeftButtonUp" Handler="SetPointerUp"/>
     <EventSetter Event="PreviewMouseMove" Handler="SetPointerMove"/>
     <EventSetter Event="LostMouseCapture" Handler="SetPointerLostCapture"/>
     <EventSetter Event="QueryContinueDrag" Handler="SetQueryContinueDrag"/>
     <EventSetter Event="DragOver" Handler="SetHeaderDragOver"/>
     <EventSetter Event="Drop" Handler="SetHeaderDrop"/>
     <Setter Property="Header" Value="{Binding Label}"/>
     <Setter Property="Width" Value="52"/>
     <Setter Property="ToolTip" Value="{Binding Label}"/><Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
     <Setter Property="HeaderTemplate"><Setter.Value><DataTemplate>
      <TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Height="14" LineHeight="14" LineStackingStrategy="BlockLineHeight"/>
     </DataTemplate></Setter.Value></Setter>
    </Style></TabControl.ItemContainerStyle>
   </TabControl>
   <Grid x:Name="IntentSetDropFeedback" Grid.Column="1" ClipToBounds="True" IsHitTestVisible="False">
    <Border x:Name="IntentSetInsertionMarker" Width="2" HorizontalAlignment="Left" Margin="0,2,0,0" Visibility="Collapsed"
     Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}">
     <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
    </Border>
   </Grid>
   <Button x:Name="IntentSetScrollRightButton" Grid.Column="2" Content="›" Width="26" Margin="2,2,0,1" Padding="0"
    IsEnabled="False" Click="IntentSetScrollRight" ToolTip="右のセットを表示" AutomationProperties.Name="右のセットを表示"/>
  </Grid>


  <Border x:Name="IntentSetContentBorder" Grid.Row="4" Margin="2,0,2,0">
   <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding HasIntentSets}" Value="True">
    <Setter Property="BorderThickness" Value="1,0,1,1"/><Setter Property="BorderBrush" Value="{Binding BorderBrush,ElementName=IntentSetSegments}"/>
    <Setter Property="Background" Value="{Binding Background,ElementName=IntentSetSegments}"/>
   </DataTrigger></Style.Triggers></Style></Border.Style>
  <Grid>
   <ScrollViewer x:Name="PaletteTileScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <ItemsControl x:Name="IntentTileItems" ItemsSource="{Binding IntentTiles}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:PaletteTilePanel LayoutMode="{Binding PaletteLayout}" FixedColumns="{Binding PaletteFixedColumns}" ViewportWidth="{Binding ViewportWidth,RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Grid x:Name="TileCell" Margin="3" Background="Transparent" AllowDrop="True" DragOver="TileDragOver" Drop="TileDrop"
       PreviewMouseLeftButtonDown="TilePointerDown" PreviewMouseLeftButtonUp="TilePointerUp" PreviewMouseMove="TilePointerMove" LostMouseCapture="TilePointerLostCapture"
       ContextMenuOpening="TileContextOpening" ContextMenuService.ShowOnDisabled="True">
       <Grid.ContextMenu><ContextMenu><MenuItem Header="編集"/></ContextMenu></Grid.ContextMenu>
       <Button Command="{Binding DataContext.ExecuteIntentTileCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}"
        CommandParameter="{Binding}" ToolTip="{Binding AppearanceDescription}" ToolTipService.ShowOnDisabled="True" Padding="12" Margin="0"
        Background="{Binding Face}" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
        BorderBrush="{Binding Accent}" BorderThickness="2"
        AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding AppearanceDescription}">
        <Button.Template><ControlTemplate TargetType="Button">
         <Border x:Name="TileFace" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding Radius}">
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
         </Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TileFace" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/><Setter TargetName="TileFace" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TileFace" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/><Setter TargetName="TileFace" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="TileFace" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TileFace" Property="Opacity" Value="0.55"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate></Button.Template>
        <TextBlock IsHitTestVisible="False" Text="{Binding Label}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" MaxHeight="54"/>
       </Button>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
   <StackPanel VerticalAlignment="Top" Margin="8,12">
    <TextBlock x:Name="IntentEmptyNotice" Text="{Binding IntentNotice}" TextWrapping="Wrap" Margin="0,0,0,8" IsHitTestVisible="False"/>
    <Button x:Name="IntentEmptyActionButton" Content="{Binding IntentEmptyActionLabel}" Command="{Binding OpenIntentSettingsCommand}" HorizontalAlignment="Left" Padding="10,5">
     <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowIntentEmptyAction}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
    </Button>
   </StackPanel>
  </Grid>
  </Border>

  <Grid Grid.Row="5" HorizontalAlignment="Right" Margin="0,6,0,0">
   <ToggleButton x:Name="PanelQuickSettingsButton" Content="⚙ 簡易設定" Padding="10,5" Checked="PanelQuickSettingsOpened" AutomationProperties.Name="配置パネルの簡易設定"/>
   <Popup x:Name="PanelQuickSettingsPopup" Placement="Top" PlacementTarget="{Binding ElementName=PanelQuickSettingsButton}" StaysOpen="True" AllowsTransparency="True"
    IsOpen="{Binding IsChecked,ElementName=PanelQuickSettingsButton,Mode=TwoWay}"
    DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
    <Border Padding="10" Width="340" MaxHeight="410" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1">
     <local:PanelQuickSettingsPanel x:Name="PanelQuickSettingsSurface"/>
    </Border>
   </Popup>
  </Grid>
 </Grid>
</UserControl>
