<UserControl x:Class="Ymm4TemplatePlacer.IntentPalettePanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="6">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <StackPanel x:Name="IntentContextHeader" Grid.Row="0" Margin="3,1,3,7">
   <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IntentContextTitle}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
   <TextBlock x:Name="IntentContextTitleText" Text="{Binding IntentContextTitle}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
   <TextBlock x:Name="IntentContextDetailText" Text="{Binding IntentContextDetail}" Opacity="0.72" TextTrimming="CharacterEllipsis" ToolTip="{Binding IntentContextDetail}"/>
   <TextBlock x:Name="ContextCompatibilityNoticeText" Text="{Binding PlacementContextCompatibilityNotice}" TextWrapping="Wrap" Margin="0,4,0,0" FontWeight="SemiBold">
    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding PlacementContextCompatibilityNotice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
  </StackPanel>

  <DockPanel Grid.Row="1">
   <Button x:Name="IntentSetSettingsButton" DockPanel.Dock="Right" Content="Set全体 ▾" HorizontalAlignment="Right" Padding="8,3" Margin="4,0,2,6" Click="SetSettingsClick" IsEnabled="{Binding HasCurrentIntentSet}" AutomationProperties.Name="このSet全体の設定"/>
   <TextBlock x:Name="SingleSetTitleText" Text="{Binding SelectedIntentSet.Label}" FontWeight="SemiBold" Margin="4,0,4,6">
   <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowSingleSetName}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
  </DockPanel>

  <DockPanel x:Name="IntentSetRow" Grid.Row="2" Margin="2,6,2,8">
   <DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding HasIntentSets}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></DockPanel.Style>
   <TextBlock Text="セット" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left"/>
   <ComboBox x:Name="IntentSetPicker" ItemsSource="{Binding IntentSets}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedIntentSet,Mode=TwoWay}" MinWidth="120" HorizontalContentAlignment="Stretch" AutomationProperties.Name="セットを選択">
    <ComboBox.Style><Style TargetType="ComboBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding UseIntentSetPicker}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
   </ComboBox>
   <ListBox x:Name="IntentSetSegments" ItemsSource="{Binding IntentSets}" SelectedItem="{Binding SelectedIntentSet,Mode=TwoWay}" BorderThickness="0" Background="Transparent"
    ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="セットを切り替える">
    <ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding UseSegmentedIntentSets}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Padding="10,5"/></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </DockPanel>

  <Grid Grid.Row="3">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl x:Name="IntentTileItems" ItemsSource="{Binding IntentTiles}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="104" ItemHeight="104"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Grid x:Name="TileCell" Margin="3" Background="Transparent" AllowDrop="True" DragOver="TileDragOver" Drop="TileDrop"
       PreviewMouseLeftButtonDown="TilePointerDown" PreviewMouseLeftButtonUp="TilePointerUp" PreviewMouseMove="TilePointerMove" LostMouseCapture="TilePointerLostCapture"
       ContextMenuOpening="TileContextOpening" ContextMenuService.ShowOnDisabled="True">
       <Grid.ContextMenu><ContextMenu><MenuItem Header="編集"/></ContextMenu></Grid.ContextMenu>
       <Button Command="{Binding DataContext.ExecuteIntentTileCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}"
        CommandParameter="{Binding}" ToolTip="{Binding AppearanceDescription}" ToolTipService.ShowOnDisabled="True" Padding="12" Margin="0"
        Background="{Binding Face}" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
        BorderBrush="{Binding Accent}" BorderThickness="2"
        AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding AppearanceDescription}">
        <Button.Template><ControlTemplate TargetType="Button">
         <Border x:Name="TileFace" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding Radius}">
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
         </Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TileFace" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/><Setter TargetName="TileFace" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TileFace" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/><Setter TargetName="TileFace" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="TileFace" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TileFace" Property="Opacity" Value="0.55"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate></Button.Template>
        <TextBlock IsHitTestVisible="False" Text="{Binding Label}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" MaxHeight="54"/>
       </Button>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
   <StackPanel VerticalAlignment="Top" Margin="8,12">
    <TextBlock x:Name="IntentEmptyNotice" Text="{Binding IntentNotice}" TextWrapping="Wrap" Margin="0,0,0,8" IsHitTestVisible="False"/>
    <Button x:Name="IntentEmptyActionButton" Content="{Binding IntentEmptyActionLabel}" Command="{Binding OpenIntentSettingsCommand}" HorizontalAlignment="Left" Padding="10,5">
     <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowIntentEmptyAction}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
    </Button>
   </StackPanel>
  </Grid>

  <Button x:Name="IntentSettingsButton" Grid.Row="4" Content="⚙ 設定" Command="{Binding OpenIntentSettingsCommand}" HorizontalAlignment="Right" Padding="10,5" Margin="0,6,0,0"/>
 </Grid>
</UserControl>
