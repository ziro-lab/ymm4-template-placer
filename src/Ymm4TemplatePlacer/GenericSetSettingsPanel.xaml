<UserControl x:Class="Ymm4TemplatePlacer.GenericSetSettingsPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Ymm4TemplatePlacer">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhen"/></UserControl.Resources>
 <StackPanel DataContext="{Binding IntentSettings.SelectedGenericSet}">
  <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
  <TextBlock Text="セット名"/>
  <TextBox x:Name="GenericSetNameBox" Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8" Padding="5,3"/>
  <TextBlock Text="どう置く？" FontWeight="SemiBold"/>
  <TextBlock x:Name="GenericSentenceText" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,6"/>
  <local:PlacementBehaviorPreview x:Name="GenericBehaviorPreview" DataContext="{Binding BehaviorDescription}" Margin="0,0,0,8"/>
  <CheckBox x:Name="TemplateLayerCheck" Content="テンプレートのレイヤーに置く" IsChecked="{Binding UseTemplateLayer,Mode=TwoWay}"/>
  <StackPanel Visibility="{Binding UseSavedRange,Converter={StaticResource VisibleWhen}}" Margin="0,5">
   <TextBlock Text="指定レイヤーが塞がっていたら"/>
   <ComboBox x:Name="GenericOccupiedBehaviorPicker" ItemsSource="{Binding OccupiedBehaviors}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding OccupiedBehavior,Mode=TwoWay}"/>
  </StackPanel>
  <Expander x:Name="GenericFineTuning" Header="細かく調整" Margin="0,5">
   <StackPanel Visibility="{Binding UseSavedRange,Converter={StaticResource VisibleWhen}}" Margin="8,5">
    <TextBlock Text="空きレイヤーを探す範囲"/>
    <WrapPanel><TextBox Text="{Binding Minimum,UpdateSourceTrigger=PropertyChanged}" Width="60"/><TextBlock Text=" ～ "/><TextBox Text="{Binding Maximum,UpdateSourceTrigger=PropertyChanged}" Width="60"/></WrapPanel>
    <TextBlock Text="優先レイヤー"/><TextBox Text="{Binding Preferred,UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left"/>
   </StackPanel>
  </Expander>
  <TextBlock Text="タイルと並び順" FontWeight="SemiBold" Margin="0,8,0,4"/>
  <ListBox x:Name="GenericEntryList" ItemsSource="{Binding Entries}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedEntry,Mode=TwoWay}" MinHeight="70" MaxHeight="200" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
  <WrapPanel Margin="0,4">
   <Button Content="↑ 上へ" Command="{Binding DataContext.MoveIntentEntryCommand,RelativeSource={RelativeSource AncestorType=local:GenericSetSettingsPanel}}" CommandParameter="-1" Padding="8,5" Margin="0,0,4,0"/>
   <Button Content="↓ 下へ" Command="{Binding DataContext.MoveIntentEntryCommand,RelativeSource={RelativeSource AncestorType=local:GenericSetSettingsPanel}}" CommandParameter="1" Padding="8,5" Margin="0,0,4,0"/>
   <Button Content="セットから外す" Command="{Binding DataContext.RemoveIntentEntryCommand,RelativeSource={RelativeSource AncestorType=local:GenericSetSettingsPanel}}" Padding="8,5"/>
  </WrapPanel>
  <StackPanel x:Name="GenericEntryAppearanceEditor" DataContext="{Binding SelectedEntry}">
   <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
   <TextBlock Text="タイルの表示名（空欄なら短い名前）"/>
   <TextBox x:Name="EntryAliasBox" Text="{Binding DisplayAlias,UpdateSourceTrigger=PropertyChanged}" MaxLength="128" Margin="0,3,0,6"/>
   <TextBlock Text="色ラベル"/>
   <ComboBox x:Name="EntryColorPicker" ItemsSource="{Binding DataContext.IntentTileColors,RelativeSource={RelativeSource AncestorType=local:GenericSetSettingsPanel}}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Color,Mode=TwoWay}" Margin="0,3,0,6"/>
   <TextBlock Text="形"/>
   <ComboBox x:Name="EntryShapePicker" ItemsSource="{Binding DataContext.IntentTileShapes,RelativeSource={RelativeSource AncestorType=local:GenericSetSettingsPanel}}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Shape,Mode=TwoWay}" Margin="0,3,0,6"/>
  </StackPanel>
 </StackPanel>
</UserControl>
