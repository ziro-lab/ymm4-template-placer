<UserControl x:Class="Ymm4TemplatePlacer.TemplateAdditionPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="6">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,6">
   <TextBlock Text="テンプレートを追加" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding AddTemplateDestination,StringFormat=追加先: {0}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AddTemplateDestination}"/>
  </StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,5">
   <Button Content="一覧更新" Command="{Binding RefreshAddTemplatesCommand}" DockPanel.Dock="Right" Padding="8,3" Margin="6,0,0,0"/>
   <TextBlock Text="検索 " DockPanel.Dock="Left" VerticalAlignment="Center"/>
   <TextBox x:Name="SourceSearch" Text="{Binding AddTemplateSearch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="追加するYMM4テンプレートを検索"/>
  </DockPanel>
  <ListBox x:Name="SourceList" Grid.Row="2" ItemsSource="{Binding AddTemplateSources}" DisplayMemberPath="Name" SelectedItem="{Binding AddTemplateSource,Mode=TwoWay}" TextSearch.TextPath="Name" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="元のYMM4テンプレート"/>
  <StackPanel Grid.Row="3" Margin="0,5,0,0">
   <TextBlock Text="表示名"/>
   <TextBox x:Name="NameBox" Text="{Binding AddTemplateDisplayName,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding AddTemplateUsesExisting}" MaxLength="256" AutomationProperties.Name="パレットでの表示名"/>
   <TextBlock Text="{Binding AddTemplateCharacterSummary}" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
   <TextBlock Text="{Binding AddTemplateNotice}" TextWrapping="Wrap" MaxHeight="54"/>
  </StackPanel>
  <WrapPanel Grid.Row="4" Margin="0,6,0,0">
   <Button x:Name="AddButton" Content="パレットへ追加" Command="{Binding CompleteAddTemplateCommand}" Padding="12,5" Margin="0,0,8,0"/>
   <Button x:Name="CancelButton" Content="戻る" Command="{Binding CancelAddTemplateCommand}" Padding="12,5"/>
  </WrapPanel>
 </Grid>
</UserControl>
