<UserControl x:Class="Ymm4TemplatePlacer.QuickDropControls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="0,6,0,0">
  <WrapPanel>
   <Button x:Name="DropButton" Content="再生位置へ配置" Command="{Binding QuickDropCommand}" Padding="10,5" Margin="0,0,8,4" ToolTip="パレットの項目を左ダブルクリックするのと同じ操作です。"/>
   <ComboBox ItemsSource="{Binding QuickDropModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding QuickDropMode,Mode=TwoWay}" MinWidth="190" VerticalAlignment="Center" Margin="0,0,0,4">
    <ComboBox.Style><Style TargetType="ComboBox"><Style.Triggers><DataTrigger Binding="{Binding IsCharacterPaletteMode}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
   </ComboBox>
   <TextBlock Text="スタイルパレットは基準配置" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCharacterPaletteMode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </WrapPanel>
  <TextBlock Text="{Binding PaletteLayerNotice}" TextWrapping="Wrap" Opacity="0.75"/>
  <Expander x:Name="LayerEditor" Header="レイヤー設定" Margin="0,4,0,0">
   <StackPanel>
    <TextBlock Text="{Binding PaletteLayerSummary}" TextWrapping="Wrap"/>
    <CheckBox Content="基準配置はテンプレートのレイヤーを使用する" IsChecked="{Binding PaletteUseTemplateLayer,Mode=TwoWay}" Margin="0,3"/>
    <TextBlock Text="探索範囲（前面・背面でも使用）／優先（基準の範囲探索で使用）" TextWrapping="Wrap" Opacity="0.75"/>
    <WrapPanel Margin="0,3,0,0">
     <StackPanel Margin="0,0,8,0"><TextBlock Text="最小"/><TextBox Text="{Binding PaletteMinimumText,UpdateSourceTrigger=PropertyChanged}" Width="60"/></StackPanel>
     <StackPanel Margin="0,0,8,0"><TextBlock Text="最大"/><TextBox Text="{Binding PaletteMaximumText,UpdateSourceTrigger=PropertyChanged}" Width="60"/></StackPanel>
     <StackPanel Margin="0,0,8,0"><TextBlock Text="優先"/><TextBox Text="{Binding PalettePreferredText,UpdateSourceTrigger=PropertyChanged}" Width="60"/></StackPanel>
     <Button x:Name="SaveLayerButton" Content="このパレットへ保存" Command="{Binding SavePaletteLayerCommand}" Padding="10,4" VerticalAlignment="Bottom"/>
    </WrapPanel>
   </StackPanel>
  </Expander>
 </StackPanel>
</UserControl>
