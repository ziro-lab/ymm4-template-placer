<UserControl x:Class="Ymm4TemplatePlacer.PlacerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Ymm4TemplatePlacer" MinWidth="360" MinHeight="280"
 Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
 Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
 <Grid Margin="8">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,6">
   <TextBlock Text="{Binding SceneName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
  </DockPanel>
  <TabControl x:Name="MainTabs" Grid.Row="1" SelectedIndex="0">
   <TabControl.Style><Style TargetType="TabControl"><Style.Triggers><DataTrigger Binding="{Binding IsAddingTemplate}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsManagingTemplates}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TabControl.Style>
   <TabItem x:Name="PaletteTab" Header="配置"><local:PalettePanel x:Name="PaletteSurface"/></TabItem>
   <TabItem x:Name="ExpressionTab" Header="表情をまとめて">
    <Grid Margin="6">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Margin="0,0,0,6">
      <WrapPanel x:Name="ExpressionSourceSwitch" Margin="0,0,0,5">
       <WrapPanel.Style><Style TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding UseLegacyWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
       <RadioButton x:Name="TemplateExpressionSource" GroupName="ExpressionSource" Content="テンプレート" IsChecked="{Binding IsTemplateExpressionSource,Mode=TwoWay}" Margin="0,0,12,0"/>
       <RadioButton x:Name="TachiePresetExpressionSource" GroupName="ExpressionSource" Content="表情プリセット（実験）" IsChecked="{Binding IsTachiePresetExpressionSource,Mode=TwoWay}"/>
      </WrapPanel>
      <TextBlock Text="{Binding Summary}" Opacity="0.75" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}"/>
      <WrapPanel HorizontalAlignment="Right">
       <TextBlock Text="行の高さ" VerticalAlignment="Center" Margin="0,0,5,0"/>
       <TextBox x:Name="ExpressionRowHeightBox" Text="{Binding ExpressionRowHeight,Mode=OneWay}" IsEnabled="{Binding CanEditExpressionRowHeight}"
        Width="44" MaxLength="2" Padding="4,2" TextAlignment="Right"
        PreviewKeyDown="ExpressionRowHeightBoxKeyDown" LostKeyboardFocus="ExpressionRowHeightBoxLostFocus"
        ToolTip="32～96。Enterで適用、Escで戻します。行の下端をドラッグしても変更できます。"
        AutomationProperties.Name="セリフ一覧の共通行高さ"/>
       <TextBlock Text="px" VerticalAlignment="Center" Margin="4,0,0,0"/>
      </WrapPanel>
      <TextBlock x:Name="TachiePresetPlacementRuleLabel" Text="配置ルール" FontWeight="SemiBold" Margin="0,3,0,1">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTachiePresetExpressionSource}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <local:ExpressionPresetPanel x:Name="PresetSurface"/>
      <TextBlock x:Name="TachiePresetSourceNotice" Text="{Binding ExpressionSourceNotice}" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.8">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTachiePresetExpressionSource}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <TextBlock x:Name="ExpressionFreshnessWarning" Text="{Binding ExpressionFreshnessNotice}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0">
       <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ExpressionFreshnessNotice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </StackPanel>
     <Border Grid.Row="1" Panel.ZIndex="5" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="8" Padding="10,5" IsHitTestVisible="False" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1">
      <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsExpressionLoading}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <TextBlock Text="{Binding ExpressionLoadingNotice}" TextWrapping="Wrap"/>
     </Border>
     <DataGrid x:Name="VoiceGrid" IsEnabled="{Binding CanEditExpressionRows}" Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionUnit="FullRow" SelectionMode="Single" RowHeight="{Binding ExpressionRowHeight}" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
      <DataGrid.Style><Style TargetType="DataGrid"><Style.Triggers><DataTrigger Binding="{Binding ExpressionRowsMatchSource}" Value="False"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers></Style></DataGrid.Style>
      <DataGrid.RowStyle><Style TargetType="DataGridRow">
       <EventSetter Event="PreviewMouseMove" Handler="VoiceGridRow_PreviewMouseMove"/>
       <EventSetter Event="PreviewMouseLeftButtonDown" Handler="VoiceGridRow_PreviewMouseLeftButtonDown"/>
       <EventSetter Event="PreviewMouseLeftButtonUp" Handler="VoiceGridRow_PreviewMouseLeftButtonUp"/>
       <EventSetter Event="LostMouseCapture" Handler="VoiceGridRow_LostMouseCapture"/>
       <EventSetter Event="MouseLeave" Handler="VoiceGridRow_MouseLeave"/>
       <EventSetter Event="MouseLeftButtonUp" Handler="VoiceGridRow_Click"/>
       <Setter Property="ToolTip"><Setter.Value><ToolTip><StackPanel MaxWidth="420"><TextBlock Text="{Binding Character}" FontWeight="SemiBold"/><TextBlock Text="{Binding SourceNotice}" TextWrapping="Wrap"/><TextBlock Text="{Binding Serif}" TextWrapping="Wrap"/><TextBlock Text="{Binding Frame,StringFormat=開始: {0} フレーム}"/><TextBlock Text="{Binding Length,StringFormat=長さ: {0} フレーム}"/></StackPanel></ToolTip></Setter.Value></Setter>
      </Style></DataGrid.RowStyle>
      <DataGrid.Columns>
       <DataGridTextColumn Header="No" Binding="{Binding No}" IsReadOnly="True" Width="28"/>
       <DataGridTextColumn Header="キャラ" Binding="{Binding Character}" IsReadOnly="True" Width="64"/>
       <DataGridTemplateColumn Header="セリフ" Width="*" MinWidth="86" SortMemberPath="Serif"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Serif}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ClipToBounds="True" VerticalAlignment="Center" Margin="5,0" ToolTip="{Binding Serif}" ToolTipService.ShowDuration="60000"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="テンプレート" Width="1.2*" MinWidth="112"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid ToolTip="{Binding SourceNotice}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox Grid.Column="0" DropDownOpened="ExpressionChoiceOpened" ItemsSource="{Binding Choices}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedChoice,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="2" VerticalContentAlignment="Center" ToolTip="{Binding SelectedChoice.Label}">
         <ComboBox.Style><Style TargetType="ComboBox"><Style.Triggers><DataTrigger Binding="{Binding HasCandidates}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding SelectedChoice.IsCurrentOtherSource}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding SelectedChoice.IsAvailable}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
        </ComboBox>
        <Button Grid.Column="1" Content="Setへ登録" Command="{Binding DataContext.RegisterTachiePresetSourceCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="6,2" Margin="2" ToolTip="検出した表情プリセットを配置SourceとしてSetへ登録します。登録後は通常の配置タイルからも使えます。">
         <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanRegisterSelectedPreset}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
        <Button Grid.ColumnSpan="2" Content="＋ 表情を追加" Command="{Binding DataContext.AddExpressionTemplateCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2" ToolTip="このキャラクターの表情テンプレートがありません。ここから追加できます。">
         <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasCandidates}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding SelectedChoice.IsAvailable}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding SelectedChoice.IsCurrentOtherSource}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding DataContext.IsTachiePresetExpressionSource,RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
        <TextBlock Grid.ColumnSpan="2" Text="{Binding SourceNotice}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="4,1" VerticalAlignment="Center" FontSize="11">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasCandidates}" Value="False"/><Condition Binding="{Binding SelectedChoice.IsCurrentOtherSource}" Value="False"/><Condition Binding="{Binding SelectedChoice.IsAvailable}" Value="True"/><Condition Binding="{Binding DataContext.IsTachiePresetExpressionSource,RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
       </Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock x:Name="ExpressionEmptyNotice" Grid.Row="1" Text="このシーンには音声がありません。YMM4で音声を追加すると、自動的に一覧へ表示されます。" TextWrapping="Wrap" Margin="8,28,8,8" IsHitTestVisible="False">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Rows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ExpressionRowsMatchSource}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsExpressionLoading}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
     <TextBlock x:Name="TachiePresetRowsPlaceholder" Grid.Row="1" Text="表情プリセットの候補を準備しています。表示されない場合は［一覧を読み直す］で再確認してください。" Margin="8,30,8,8" TextWrapping="Wrap" IsHitTestVisible="False">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsTachiePresetExpressionSource}" Value="True"/><Condition Binding="{Binding ExpressionRowsMatchSource}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
     <ScrollViewer x:Name="ExpressionRowDetail" Grid.Row="2" DataContext="{Binding SelectedItem,ElementName=VoiceGrid}" Visibility="Collapsed" MaxHeight="58" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="2,4,2,0">
      <TextBlock x:Name="ExpressionSelectedSerif" Text="{Binding Serif}" TextWrapping="Wrap"><TextBlock.ToolTip><ToolTip><StackPanel><TextBlock Text="{Binding Frame,StringFormat=開始: {0} フレーム}"/><TextBlock Text="{Binding Length,StringFormat=長さ: {0} フレーム}"/></StackPanel></ToolTip></TextBlock.ToolTip></TextBlock>
     </ScrollViewer>
     <StackPanel Grid.Row="3" Margin="0,5,0,0">
      <Button x:Name="PlaceButton" Content="表情を配置" Command="{Binding PlaceCommand}" Padding="12,5" Margin="0,0,0,4" HorizontalAlignment="Left" ToolTip="{Binding ExpressionPlaceHint}" ToolTipService.ShowOnDisabled="True">
       <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowExpressionBatchPlace}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
      </Button>
      <WrapPanel>
       <Expander x:Name="ExcelEditor" Header="Excelでまとめて編集" Margin="0,0,10,0">
        <Expander.Style><Style TargetType="Expander"><Style.Triggers><DataTrigger Binding="{Binding IsTachiePresetExpressionSource}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Expander.Style>
        <WrapPanel Margin="0,3,0,0"><Button Content="Excelへ出力" Command="{Binding ExportCommand}" Padding="10,4" Margin="0,0,8,0"/><Button Content="Excelから読み込み" Command="{Binding ImportCommand}" Padding="10,4"/></WrapPanel>
       </Expander>
       <Expander x:Name="ExpressionMaintenance" Header="メンテナンス">
        <StackPanel>
         <Button x:Name="ResyncButton" Content="選択した表情を再同期" Command="{Binding ResyncCommand}" Padding="8,3" Margin="0,3,0,0" ToolTip="{Binding ResyncHint}" ToolTipService.ShowOnDisabled="True"/>
         <Button x:Name="RefreshButton" Content="一覧を読み直す" Command="{Binding RefreshCommand}" Padding="8,3" Margin="0,3,0,0" ToolTip="未配置の割り当てを確認してから、現在の音声と候補を読み直します。"/>
         <Button x:Name="TachiePresetCalibrationButton" Content="{Binding TachiePresetCalibrationActionText}" Command="{Binding TachiePresetCalibrationCommand}"
          CommandParameter="{Binding SelectedItem,ElementName=VoiceGrid}" Padding="8,3" Margin="0,3,0,0"
          ToolTip="自動で表情プリセットを見つけられない立ち絵Plugin向け。確認用アイテムを1個置き、1回のプリセット変更から読み取り経路を認識します。">
          <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTachiePresetExpressionSource}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
         </Button>
         <TextBlock x:Name="TachiePresetCalibrationNoticeText" Text="{Binding TachiePresetCalibrationNotice}" TextWrapping="Wrap" Margin="0,3,0,0" Opacity="0.75" FontSize="11">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTachiePresetExpressionSource}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
        </StackPanel>
       </Expander>
      </WrapPanel>
     </StackPanel>
    </Grid>
   </TabItem>
   <TabItem x:Name="SelectionTab" Header="設定"><local:SelectionPanel x:Name="SelectionSurface"/></TabItem>
  </TabControl>
  <local:TemplateAdditionPanel x:Name="TemplateAdditionSurface" Grid.Row="1">
   <local:TemplateAdditionPanel.Style><Style TargetType="local:TemplateAdditionPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsAddingTemplate}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsManagingTemplates}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></local:TemplateAdditionPanel.Style>
  </local:TemplateAdditionPanel>
  <Grid x:Name="LibraryTaskSurface" Grid.Row="1">
   <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsManagingTemplates}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="6,0,6,4"><Button x:Name="BackFromManagementButton" Content="戻る" Command="{Binding CloseTemplateManagementCommand}" DockPanel.Dock="Left" Padding="10,4" Margin="0,0,8,0"/><TextBlock Text="テンプレート管理" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
   <local:LibraryPanel x:Name="LibrarySurface" Grid.Row="1"/>
  </Grid>
  <ScrollViewer Grid.Row="2" MaxHeight="48" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
   <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
   <TextBlock x:Name="StatusText" Text="{Binding Status}" TextWrapping="Wrap">
    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
  </ScrollViewer>
 </Grid>
</UserControl>
