<UserControl x:Class="Ymm4TemplatePlacer.SelectionPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Ymm4TemplatePlacer">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <local:PlacementPurposeConverter x:Key="Purpose"/>
  <Style x:Key="SavedChoices" TargetType="Control"><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding SelectionPresetDirty}" Value="True"><Setter Property="IsEnabled" Value="False"/><Setter Property="ToolTip" Value="編集中の配置条件を保存するか、編集を戻してください。"/></DataTrigger></Style.Triggers></Style>
 </UserControl.Resources>
 <Grid Margin="6">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel>
   <TextBlock Text="{Binding SelectionContext}" TextWrapping="Wrap" Margin="0,0,0,5" Opacity="0.75"/>
   <TextBlock Text="何を置く？" FontWeight="SemiBold"/>
   <ComboBox x:Name="TemplateSelector" ItemsSource="{Binding SelectionTemplates}" SelectedItem="{Binding SelectionTemplate,Mode=TwoWay}" TextSearch.TextPath="DisplayName" Margin="0,3,0,6" AutomationProperties.Name="配置するテンプレート">
    <ComboBox.ItemTemplate><DataTemplate><StackPanel>
     <StackPanel.ToolTip><ToolTip><StackPanel MaxWidth="400"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding CharacterName}"/><TextBlock Text="{Binding SourceName}" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></StackPanel></ToolTip></StackPanel.ToolTip>
     <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <TextBlock FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis"><Run Text="{Binding CharacterName}"/><Run Text=" ｜ "/><Run Text="{Binding SourceName}"/></TextBlock>
     <TextBlock Text="{Binding Status}" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </StackPanel></DataTemplate></ComboBox.ItemTemplate>
   </ComboBox>
   <TextBlock Text="パレットの［＋ テンプレートを追加］で、使いたいものを追加してください。" TextWrapping="Wrap" Margin="0,0,0,5">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectionTemplates.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
   <TextBlock Text="どこに置く？" FontWeight="SemiBold"/>
   <ListBox x:Name="ProfileSelector" Style="{StaticResource SavedChoices}" ItemsSource="{Binding SelectionProfiles}" SelectedItem="{Binding SelectedSelectionProfile,Mode=TwoWay}" SelectionMode="Single" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,3,0,6" AutomationProperties.Name="配置する位置と範囲">
    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="4,4"/><Setter Property="Margin" Value="0,0,6,0"/></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><RadioButton Content="{Binding Value,Converter={StaticResource Purpose}}" IsChecked="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem},Mode=TwoWay}"/></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <DockPanel Margin="0,0,0,4">
    <TextBlock Text="条件 " VerticalAlignment="Center" DockPanel.Dock="Left"/>
    <ComboBox x:Name="SelectionPresetSelector" Style="{StaticResource SavedChoices}" ItemsSource="{Binding SelectionPresets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSelectionPreset,Mode=TwoWay}" ToolTip="保存した配置条件を切り替えます。"/>
   </DockPanel>
   <TextBlock Text="{Binding SelectionPresetNotice}" TextWrapping="Wrap" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SelectionPresetNotice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <Expander x:Name="SelectionPresetEditor" Header="配置条件を編集" Margin="0,2,0,6">
    <StackPanel Margin="4">
     <TextBlock Text="ここでは、選択したアイテムに対してどこへ・どの長さで置くかを調整します。0は調整なしです。" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,6"/>
     <TextBlock Text="プリセット名"/>
     <TextBox Text="{Binding SelectionDraft.Name,UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
     <StackPanel Visibility="{Binding IsCompanionProfile,Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="対象の開始・終了を基準にします。開始を負にすると手前へ、終了を正にすると後ろへ延長。" TextWrapping="Wrap"/>
     </StackPanel>
     <StackPanel Visibility="{Binding IsPointProfile,Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="基準点（割合の端数は切り捨て）"/>
      <ComboBox ItemsSource="{Binding SelectionAnchors}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectionDraft.AnchorPercent,Mode=TwoWay}" Margin="0,2,0,6"/>
      <TextBlock Text="固定長（フレーム、1以上）"/>
      <TextBox Text="{Binding SelectionDraft.Duration,UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
     </StackPanel>
     <StackPanel x:Name="BoundaryFields">
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedSelectionPreset.Profile}" Value="{x:Static local:SelectionProfile.Boundary}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="2つのアイテムの終了と開始が許容差内のときだけ配置します。基準は先に始まるアイテムの終了です。同じ開始位置では停止します。" TextWrapping="Wrap"/>
      <TextBlock Text="境界の許容差（フレーム、0なら隙間・重なりなし）" TextWrapping="Wrap"/>
      <TextBox Text="{Binding SelectionDraft.Tolerance,UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
      <TextBlock Text="固定長（フレーム、1以上）"/>
      <TextBox Text="{Binding SelectionDraft.Duration,UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
     </StackPanel>
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding SelectedSelectionPreset.Profile}" Value="{x:Static local:SelectionProfile.SelectionRange}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="開始位置の調整（フレーム）"/>
      <TextBox Text="{Binding SelectionDraft.StartOffset,UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
     </StackPanel>
     <StackPanel Visibility="{Binding IsCompanionProfile,Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="終了位置の調整（フレーム）"/>
      <TextBox Text="{Binding SelectionDraft.EndOffset,UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
     </StackPanel>
     <StackPanel x:Name="RangePaddingFields">
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedSelectionPreset.Profile}" Value="{x:Static local:SelectionProfile.SelectionRange}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="選択したアイテム全体を1つで覆います。余白は0以上のフレーム数です。" TextWrapping="Wrap"/>
      <TextBlock Text="開始前の余白"/>
      <TextBox Text="{Binding SelectionDraft.HeadPadding,UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
      <TextBlock Text="終了後の余白"/>
      <TextBox Text="{Binding SelectionDraft.TailPadding,UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
     </StackPanel>
     <CheckBox Content="テンプレートのレイヤーを使う（重なる場合は停止）" IsChecked="{Binding SelectionDraft.UseTemplateLayer}" Margin="0,2,0,6"/>
     <TextBlock Text="レイヤー範囲を使う場合は上のチェックを外します。探索上限9999はプラグイン側の設定です。" TextWrapping="Wrap"/>
     <Grid Margin="0,4,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="最小"/><TextBox Text="{Binding SelectionDraft.Minimum,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,4,0"><TextBlock Text="最大"/><TextBox Text="{Binding SelectionDraft.Maximum,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="優先"/><TextBox Text="{Binding SelectionDraft.Preferred,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
     </Grid>
     <WrapPanel>
      <Button x:Name="SaveSelectionPresetButton" Content="保存" Command="{Binding SaveSelectionPresetCommand}" Padding="10,4" Margin="0,0,6,4"/>
      <Button Content="編集を戻す" Command="{Binding RevertSelectionPresetCommand}" Padding="10,4" Margin="0,0,6,4"/>
      <Button Content="複製" Command="{Binding CopySelectionPresetCommand}" Padding="10,4" Margin="0,0,6,4"/>
      <Button Content="このプリセットを削除" Command="{Binding DeleteSelectionPresetCommand}" Padding="10,4" Margin="0,0,0,4"/>
     </WrapPanel>
    </StackPanel>
   </Expander>
  </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="1" Margin="0,6,0,0">
   <ScrollViewer MaxHeight="54" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock Text="{Binding SelectionPreview}" TextWrapping="Wrap"/></ScrollViewer>
   <WrapPanel Margin="0,4,0,0">
    <Button x:Name="PlaceSelectionButton" Content="配置する" Command="{Binding PlaceSelectionCommand}" Padding="12,5" Margin="0,0,8,0" ToolTip="{Binding SelectionPlaceHint}" ToolTipService.ShowOnDisabled="True"/>
    <Button x:Name="PreviewSelectionButton" Content="予定を更新" Command="{Binding PreviewSelectionCommand}" Padding="8,3" VerticalAlignment="Center" ToolTip="通常は選択・テンプレート・保存条件の変更で自動更新します。元アイテムを編集した後などはここで更新できます。配置時には必ず最新状態で再検証します。"/>
   </WrapPanel>
  </StackPanel>
 </Grid>
</UserControl>
