<UserControl x:Class="Ymm4TemplatePlacer.SelectionPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Ymm4TemplatePlacer">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="8">
   <TextBlock Text="Timelineの選択Itemとの関係で配置" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding SelectionContext}" TextWrapping="Wrap" Margin="0,4,0,8"/>
   <TextBlock Text="配置関係"/>
   <ComboBox x:Name="ProfileSelector" ItemsSource="{Binding SelectionProfiles}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedSelectionProfile,Mode=TwoWay}" Margin="0,2,0,6"/>
   <TextBlock Text="Preset"/>
   <ComboBox x:Name="SelectionPresetSelector" ItemsSource="{Binding SelectionPresets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSelectionPreset,Mode=TwoWay}" Margin="0,2,0,6"/>
   <TextBlock Text="Library Template（未登録ならLibraryタブで追加）" TextWrapping="Wrap"/>
   <ComboBox x:Name="TemplateSelector" ItemsSource="{Binding SelectionTemplates}" SelectedItem="{Binding SelectionTemplate,Mode=TwoWay}" TextSearch.TextPath="DisplayName" Margin="0,2,0,6">
    <ComboBox.ItemTemplate><DataTemplate><StackPanel>
     <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding CharacterName}" FontSize="11" Opacity="0.8"/>
     <TextBlock Text="{Binding SourceName}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceName}"/>
     <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.7"/>
    </StackPanel></DataTemplate></ComboBox.ItemTemplate>
   </ComboBox>
   <Expander x:Name="SelectionPresetEditor" Header="Presetの条件を編集" Margin="0,2,0,6">
    <StackPanel Margin="4">
     <TextBlock Text="Preset名"/>
     <TextBox Text="{Binding SelectionDraft.Name,UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
     <StackPanel Visibility="{Binding IsCompanionProfile,Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="対象の開始・終了を基準にします。開始を負にすると手前へ、終了を正にすると後ろへ延長。" TextWrapping="Wrap"/>
     </StackPanel>
     <StackPanel Visibility="{Binding IsPointProfile,Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="基準点（割合の端数は切り捨て）"/>
      <ComboBox ItemsSource="{Binding SelectionAnchors}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectionDraft.AnchorPercent,Mode=TwoWay}" Margin="0,2,0,6"/>
      <TextBlock Text="固定長（frame、1以上）"/>
      <TextBox Text="{Binding SelectionDraft.Duration,UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
     </StackPanel>
     <StackPanel x:Name="BoundaryFields">
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedSelectionPreset.Profile}" Value="{x:Static local:SelectionProfile.Boundary}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="2Itemの終了と開始が許容差内のときだけ配置。基準は先に始まるItemの終了。同じ開始位置では停止します。" TextWrapping="Wrap"/>
      <TextBlock Text="境界の許容差（frame、0なら隙間・重なりなし）" TextWrapping="Wrap"/>
      <TextBox Text="{Binding SelectionDraft.Tolerance,UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
      <TextBlock Text="固定長（frame、1以上）"/>
      <TextBox Text="{Binding SelectionDraft.Duration,UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
     </StackPanel>
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding SelectedSelectionPreset.Profile}" Value="{x:Static local:SelectionProfile.SelectionRange}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="開始offset（frame）"/>
      <TextBox Text="{Binding SelectionDraft.StartOffset,UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
     </StackPanel>
     <StackPanel Visibility="{Binding IsCompanionProfile,Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="終了offset（frame）"/>
      <TextBox Text="{Binding SelectionDraft.EndOffset,UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
     </StackPanel>
     <StackPanel x:Name="RangePaddingFields">
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedSelectionPreset.Profile}" Value="{x:Static local:SelectionProfile.SelectionRange}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="選択Item全体を1つで覆います。余白は0以上のframe数です。" TextWrapping="Wrap"/>
      <TextBlock Text="開始前の余白"/>
      <TextBox Text="{Binding SelectionDraft.HeadPadding,UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
      <TextBlock Text="終了後の余白"/>
      <TextBox Text="{Binding SelectionDraft.TailPadding,UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
     </StackPanel>
     <CheckBox Content="TemplateのLayerを使う（衝突時は停止）" IsChecked="{Binding SelectionDraft.UseTemplateLayer}" Margin="0,2,0,6"/>
     <TextBlock Text="Layer範囲を使う場合は上のチェックを外す。探索上限はPlugin側の9999。" TextWrapping="Wrap"/>
     <Grid Margin="0,4,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="最小"/><TextBox Text="{Binding SelectionDraft.Minimum,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,4,0"><TextBlock Text="最大"/><TextBox Text="{Binding SelectionDraft.Maximum,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="優先"/><TextBox Text="{Binding SelectionDraft.Preferred,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
     </Grid>
     <WrapPanel>
      <Button x:Name="SaveSelectionPresetButton" Content="保存" Command="{Binding SaveSelectionPresetCommand}" Padding="10,4" Margin="0,0,6,4"/>
      <Button Content="編集を戻す" Command="{Binding RevertSelectionPresetCommand}" Padding="10,4" Margin="0,0,6,4"/>
      <Button Content="複製" Command="{Binding CopySelectionPresetCommand}" Padding="10,4" Margin="0,0,6,4"/>
      <Button Content="このPresetを削除" Command="{Binding DeleteSelectionPresetCommand}" Padding="10,4" Margin="0,0,0,4"/>
     </WrapPanel>
    </StackPanel>
   </Expander>
   <TextBlock Text="{Binding SelectionPresetNotice}" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8"/>
   <WrapPanel>
    <Button x:Name="PreviewSelectionButton" Content="予定を確認" Command="{Binding PreviewSelectionCommand}" Padding="12,5" Margin="0,0,8,4"/>
    <Button x:Name="PlaceSelectionButton" Content="選択対象へ配置（追加）" Command="{Binding PlaceSelectionCommand}" Padding="12,5" Margin="0,0,0,4"/>
   </WrapPanel>
   <TextBlock Text="{Binding SelectionPreview}" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
